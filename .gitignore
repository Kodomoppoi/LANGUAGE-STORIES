# ==========================================
# Language Stories - Git Ignore Rules
# ==========================================

# 1. Environment & API Secrets (Chaves de API)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Database & User-Specific Data (Bancos e dados do usuário / dicionários)
*.db
*.sqlite
*.sqlite3
backend/language_stories.db
backend/cache/
cache/
*exported_vocabulary*.json
*vocabulary*.json
*vocab*.json
*dictionary*.json
*dicionario*.json
lang_stories_*.json
user_data/
backend/user_data/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
backend/**/__pycache__/
.pytest_cache/
.coverage
htmlcov/

# 4. Virtual Environments
.venv/
venv/
ENV/
env/

# 5. Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# 7. Temporary audio / TTS Cache
backend/routers/tts_cache/
tts_cache/
