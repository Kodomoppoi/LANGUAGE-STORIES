# ===============================================
# Language Stories Backend - Environment Template
# Copie este arquivo para .env e preencha suas chaves
# NUNCA commite seu arquivo .env com credenciais reais!
# ===============================================

# Chave de API do Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo Gemini a ser utilizado
GEMINI_MODEL=gemini-3.6-flash

# Configurações do Ollama Local (opcional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
