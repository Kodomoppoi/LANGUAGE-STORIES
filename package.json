{
  "name": "language-stories-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"python -m uvicorn backend.main:app --reload --port 8000\" \"npm run dev --prefix frontend\"",
    "start": "npm run dev",
    "backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
