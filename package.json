{
  "name": "language-stories-root",
  "private": true,
  "scripts": {
    "predev": "node scripts/setup.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "node scripts/start-backend.js",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
